# EmailJS (required for suggestion/waitlist delivery — fill from EmailJS dashboard)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Backend API (production default; override locally in .env)
VITE_API_URL=https://compear-backend.onrender.com

# Where suggestion/waitlist emails are delivered
VITE_ADMIN_EMAIL=admin@compears.shop

# Waitlist + suggestion emails use EmailJS above. If EmailJS is unset,
# waitlist signup only stores a local sent flag (no email is claimed as sent).
